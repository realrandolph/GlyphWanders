# HTTPS origin, no path. MCP resource/audience is this origin + /mcp.
PUBLIC_URL=https://glyph.example.com
# Exact issuer from your provider discovery (Auth0 usually has a trailing slash).
OAUTH_ISSUER=https://YOUR-TENANT.us.auth0.com/
# Immutable OAuth subject of the one authorized owner, NOT an email address.
OAUTH_SUBJECT=auth0|REPLACE
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set the same value in the Devvit secret setting bridge-token.
WORKER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SQLITE_PATH=./data/glyphwanders.sqlite
HOST=127.0.0.1
PORT=3000
# Optional, short-lived token from MCP Inspector OAuth for manual smoke test only.
# Never give this token to ChatGPT or commit it.
# SMOKE_ACCESS_TOKEN=
