# Stateless OAuth-to-Devvit adapter. No database or OpenAI API key.
PUBLIC_URL=https://glyph.example.com
OAUTH_ISSUER=https://YOUR-TENANT.us.auth0.com/
OAUTH_SUBJECT=auth0|REPLACE_WITH_OWNER_USER_ID
# Copy the actual installation endpoint from Reddit; never include a token in a URL.
DEVVIT_MCP_URL=https://glyphwanders-SUBREDDITID-external.devvit.net/external/mcp
# Create a managed App Token in Devvit Developer Settings (external endpoint access required).
DEVVIT_TOKEN=devvit_at_REPLACE_WITH_MANAGED_TOKEN
HOST=127.0.0.1
PORT=3000
# Optional, short-lived OWNER OAuth token for manual smoke test; never share in chat.
# SMOKE_ACCESS_TOKEN=
