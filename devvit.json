{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "glyphwanders",
  "server": {
    "dir": "dist/server",
    "entry": "index.js",
    "externalEndpoints": {
      "mcp": {
        "endpoint": "/external/mcp",
        "scopes": ["global"]
      }
    }
  },
  "permissions": {
    "redis": true,
    "reddit": true
  },
  "triggers": {
    "onCommentCreate": "/internal/triggers/comment"
  },
  "dev": {
    "subreddit": "GlyphsPlayground"
  },
  "scripts": {
    "dev": "npm run watch"
  }
}
