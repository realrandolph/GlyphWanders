{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "glyphwanders",
  "server": {
    "dir": "dist/server",
    "entry": "index.js",
    "externalEndpoints": {
      "mcp": {
        "endpoint": "/external/mcp",
        "scopes": ["global"]
      }
    }
  },
  "permissions": {
    "redis": true,
    "reddit": true
  },
  "menu": {
    "items": [
      {
        "label": "[glyphwanders] Publication journal",
        "description": "Read-only summary of publication statuses. Never resubmit pending or uncertain writes.",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/journal"
      }
    ]
  },
  "triggers": {
    "onCommentCreate": "/internal/triggers/comment"
  },
  "dev": {
    "subreddit": "GlyphsPlayground"
  },
  "scripts": {
    "dev": "npm run watch"
  }
}
